easyblock = 'CMakeNinja'
name = 'dpcpp'
version = '6.0.0_54cbbec1'

homepage = 'https://github.com/intel/llvm'
description = """The DPC++ is a LLVM-based compiler project that implements
compiler and runtime support for the SYCL language"""

moduleclass = 'compiler'

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

source_urls = ["https://github.com/intel/llvm/archive/"]
sources = [
    '54cbbec17bcad512f18881562c5f204936e9f3b3.tar.gz',
]
checksums = ['efe8c875dbbde646578e7d22f3a524917a6d425287fff034838cac6a92da6df0']

builddependencies = [
    ('CMake', '3.29.3'),
    ('Ninja', '1.12.1'),
    ('Python', '3.12.3'),
]
dependencies = [
    ('binutils', '2.42'),
    ('hwloc', '2.10.0'),
]

configure_without_installdir = True
configure_cmd = "python %(start_dir)s/buildbot/configure.py \
-o %(builddir)s/build -t Release --cmake-gen Ninja \
--cmake-opt=\"-DCMAKE_INSTALL_PREFIX=%(installdir)s\""
build_cmd_targets = "deploy-sycl-toolchain"
build_dir = "%(builddir)s/build"
buildopts = "-C " + build_dir + " " + build_cmd_targets
installopts =  "-C " + build_dir
install_target_subdir = "%(builddir)s/build/install"
